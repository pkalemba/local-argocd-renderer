{
  "branches": ["main"],
  "plugins": [
    "@semantic-release/commit-analyzer",
    "@semantic-release/release-notes-generator",
    [
      "@semantic-release/exec",
      {
        "prepareCmd": "make checksums VERSION=v${nextRelease.version}",
        "publishCmd": "make image-push VERSION=v${nextRelease.version}"
      }
    ],
    [
      "@semantic-release/github",
      {
        "assets": [
          { "path": "dist/local-argocd-renderer_*" },
          { "path": "dist/checksums.txt" }
        ],
        "successComment": false,
        "failComment": false
      }
    ]
  ]
}
